# Local development values only
# Copy this file to .env before building rwkv_app
x-api-key=

# Release distribution (used by GitHub Actions and Fastlane; keep real tokens in secrets)
HF_DATASETS_ID=HaloWang/rwkv-chat
HF_TOKEN=
MODELSCOPE_REPO_ID=HaloWang1991/rwkv-chat
MODELSCOPE_API_TOKEN=
MODELSCOPE_ENDPOINT=https://modelscope.cn
MODELSCOPE_REVISION=master

# TestFlight defaults to fresh foreground Apple ID preauthentication. Set this
# to api_key only for an explicitly selected non-interactive release.
RWKV_APPLE_AUTH_MODE=apple_id

# Optional App Store Connect API-key mode. Store the .p8 file outside this
# repository with mode 0600. External tester distribution requires a role that
# permits build metadata and tester management.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_FILEPATH=
APP_STORE_CONNECT_IN_HOUSE=false
