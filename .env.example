# Local development values only
# Copy this file to .env before building rwkv_app
x-api-key=

# Release distribution (used by GitHub Actions and Fastlane; keep real tokens in secrets)
HF_DATASETS_ID=HaloWang/rwkv-chat
HF_TOKEN=
MODELSCOPE_REPO_ID=HaloWang1991/rwkv-chat
MODELSCOPE_API_TOKEN=
MODELSCOPE_ENDPOINT=https://modelscope.cn
MODELSCOPE_REVISION=master

# TestFlight automation. Store the .p8 file outside this repository with mode 0600.
# An App Manager or Admin API key is required for external tester distribution.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_FILEPATH=
APP_STORE_CONNECT_IN_HOUSE=false
